
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wd-clans.local/schemas/raw-extraction.v0.1.schema.json",
  "title": "UCS Raw Extraction Contract v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["extraction_schema_version", "extraction_id", "source", "members"],
  "properties": {
    "extraction_schema_version": { "const": "0.1" },
    "extraction_id": { "type": "string", "minLength": 1 },
    "extracted_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_artifact_id", "artifacts"],
      "properties": {
        "primary_artifact_id": { "type": "string", "minLength": 1 },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/member"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "content_hash"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "source_location": { "type": ["string", "null"] },
        "content_hash": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "value"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "fieldCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_refs"],
      "properties": {
        "status": {
          "enum": ["OBSERVED", "NOT_VISIBLE", "UNKNOWN", "AMBIGUOUS", "CONFLICTING"]
        },
        "raw_value": {},
        "normalized_value": {},
        "normalization_method": { "type": ["string", "null"] },
        "interpretation": {
          "enum": ["NONE", "INTERPRETED"]
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_member_key", "fields"],
      "properties": {
        "source_member_key": { "type": "string", "minLength": 1 },
        "source_identity": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": ["OBSERVED", "AMBIGUOUS", "UNKNOWN"]
            },
            "source_system": { "type": "string", "minLength": 1 },
            "source_identity_id": { "type": "string", "minLength": 1 }
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rank",
            "display_name",
            "stage",
            "weapons",
            "total_kills",
            "lifetime_medals",
            "current_league_clan_medals",
            "profile_total_clan_medal_count"
          ],
          "properties": {
            "rank": { "$ref": "#/$defs/fieldCapture" },
            "display_name": { "$ref": "#/$defs/fieldCapture" },
            "role": { "$ref": "#/$defs/fieldCapture" },
            "stage": { "$ref": "#/$defs/fieldCapture" },
            "weapons": { "$ref": "#/$defs/fieldCapture" },
            "total_kills": { "$ref": "#/$defs/fieldCapture" },
            "lifetime_medals": { "$ref": "#/$defs/fieldCapture" },
            "current_league_clan_medals": { "$ref": "#/$defs/fieldCapture" },
            "profile_total_clan_medal_count": { "$ref": "#/$defs/fieldCapture" },
            "last_online_utc": { "$ref": "#/$defs/fieldCapture" }
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
